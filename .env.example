# Server
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
# Leave empty or unset on Vercel so the browser uses the deployed site's own /api routes.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000,https://your-vercel-domain.vercel.app

# Database
DATABASE_URL=postgresql://birthdayflow:birthdayflow@localhost:5432/birthdayflow?schema=public

# Scheduling
TIMEZONE=Africa/Lagos
CRON_ENABLED=true
CRON_DAILY_SCHEDULE=0 8 * * *
CRON_UPCOMING_SCHEDULE=15 8 * * *
UPCOMING_REMINDER_DAYS=7

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Images
PUBLIC_UPLOAD_BASE_URL=http://localhost:4000/uploads
CARD_CACHE_TTL_DAYS=30

# Supabase Storage
# Use a private server-side key here. Do not expose this in frontend code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=uploads
SUPABASE_MEMBER_IMAGES_BUCKET=member-images

# Optional Cloudinary future support
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
